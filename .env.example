# ==================================================
# SiteVoice AEC — Environment Variables Configuration
# ==================================================

# Server Listening Port
PORT=3000

# MongoDB Atlas Database Connection String (SRV format)
# Set your MongoDB Atlas SRV URI from the Atlas Dashboard:
# e.g., mongodb+srv://sitevoice:<password>@sitevoice.<cluster_hash>.mongodb.net/sitevoice?retryWrites=true&w=majority
MONGODB_URI=

# Google Gemini API Key
GEMINI_API_KEY=

# The value must be replaced with a Gemini model actually available to the configured API/account.
GEMINI_MODEL=
